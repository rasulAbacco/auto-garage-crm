generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrmType {
  CAR
  BIKE
  WASH
}

enum PlanType {
  BASIC
  STANDARD
  PREMIUM
}

enum SalaryStatus {
  UNPAID
  PAID
  HOLD
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ItemType {
  Part
  Labor
}

enum DynamicColumnType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
}

enum WhatsAppApprovalSource {
  whatsapp
  web
}

enum ReferrerType {
  USER
  PARTNER
}

enum ReferralStatus {
  REGISTERED
  PAID
  REWARDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum VerificationStatus {
  NOT_ORDERED
  PAID_PENDING_DOCS // Paid ₹199, documents not uploaded yet
  UNDER_REVIEW // Documents uploaded, waiting for MotorDesk admin
  VERIFIED // Approved! Badge is active
  REJECTED // Verification failed (bad scan, wrong details)
}

model User {
  id               Int     @id @default(autoincrement())
  email            String  @unique
  username         String? @unique
  password         String
  profileImage     String?
  phone            String?
  companyName      String?
  address          String?
  companyLatitude  Float?
  companyLongitude Float?
  companyAddress   String?
  gstNumber        String?

  // 🚗 NEW: Garage Configurations
  pickupDrop    Boolean @default(false)
  towingService Boolean @default(false)

  // 👑 ROLE (ONLY OWNER)
  role        String    @default("user") // DO NOT STORE TEAM HERE
  allowedCrms CrmType[] @default([])

  // 📦 Subscription
  plan       PlanType  @default(BASIC)
  planExpiry DateTime?

  // 💳 Payments & Referrals
  payments         Payment[]
  payouts          ReferralPayout[]
  myReferralCode   String           @unique
  referredByCode   String?
  referredByUserId Int?

  // 🔹 Payout & KYC (for referral earnings)
  upiId       String?
  bankAccount String?
  accountName String?
  bankName    String?
  branch      String?
  ifscCode    String?
  panNumber   String?

  panDocument     Bytes?
  panDocumentType String?

  bankProofDocument Bytes?
  bankProofType     String?

  // 🔄 NEW: Identity, Registration numbers & Document Buffers
  aadharNumber        String?
  incorporationNumber String?

  aadharDocument            Bytes?
  aadharDocumentType        String?
  gstDocument               Bytes?
  gstDocumentType           String?
  incorporationDocument     Bytes?
  incorporationDocumentType String?

  kycStatus String @default("NOT_SUBMITTED")

  referralsMade  Referral[] @relation("UserReferralsMade")
  referralRecord Referral?  @relation("UserReferralReceived")

  referredByUser User?  @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals      User[] @relation("UserReferrals")

  // 🚗 CAR CRM (OWNER DATA)
  clients          Client[]
  invoices         Invoice[]
  reminders        Reminder[]
  ocrs             OcrRecord[]
  staffMembers     CarStaff[]
  carStaffLogins   CarStaffLogin[]
  carStaffSalaries CarStaffSalary[]
  appNotifications AppNotification[]

  referredByPartnerId Int?
  referredByPartner   ReferralPartner? @relation(fields: [referredByPartnerId], references: [id])

  // 🔗 PARENT USER (FOR MULTI-CRM / SUB-USER LOGIN)
  parentUserId    Int?
  parentUser      User?     @relation("UserHierarchy", fields: [parentUserId], references: [id])
  // 🧾 CAR INVOICES
  ownedInvoices   Invoice[] @relation("OwnerInvoices")
  createdInvoices Invoice[] @relation("CreatedInvoices")
  childUsers      User[]    @relation("UserHierarchy")

  // 🏍️ BIKE CRM (OWNER DATA ONLY)
  ownedBikes            Bike[]          @relation("OwnerBikes")
  createdBikes          Bike[]          @relation("CreatedBikes")
  ownedBikeServices     BikeService[]   @relation("OwnerBikeServices")
  createdBikeServices   BikeService[]   @relation("CreatedBikeServices")
  ownedBikeInvoices     BikeInvoice[]   @relation("OwnerBikeInvoices")
  createdBikeInvoices   BikeInvoice[]   @relation("CreatedBikeInvoices")
  bikeReminders         BikeReminder[]
  ownedBikeOcrRecords   BikeOcrRecord[] @relation("OwnerBikeOcrRecords")
  createdBikeOcrRecords BikeOcrRecord[] @relation("CreatedBikeOcrRecords")
  bikeStaffs            BikeStaff[]
  bikeTeams             BikeTeam[]

  // 🧼 WASHING
  washingClients WashingClient[]
  washTeams      WashTeam[]      @relation("AdminWashTeams")

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  staffs                    Staff[]
  washingStaffs             WashingStaff[]
  washingStaffSalaries      WashingStaffSalary[]
  dynamicTables             DynamicTable[]
  whatsAppSessions          WhatsAppSession[]
  whatsAppMessages          WhatsAppMessage[]
  bikeWhatsAppSessions      BikeWhatsAppSession[]
  bikeWhatsAppMessages      BikeWhatsAppMessage[]
  washWhatsAppSessions      WashWhatsAppSession[]
  washWhatsAppMessages      WashWhatsAppMessage[]
  washingReminders          WashingReminder[]
  supportSnapshot           UserSupportSnapshot?
  isSuspended               Boolean                    @default(false)
  garageMarketplaceServices GarageMarketplaceService[]
  marketplaceBookings       MarketplaceBooking[]
  marketplacePackages       MarketplacePackage[]

  // Inventory
  inventory Inventory[]

  //Add supplier
  suppliers Supplier[]

  // 🏅 1:1 REVERSE RELATION TO GARAGE VERIFICATION MODEL
  garageVerification GarageVerification?
}

model GarageVerification {
  id     Int  @id @default(autoincrement())
  userId Int  @unique // 1:1 constraint with User
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🪙 Order Tracking
  status    VerificationStatus @default(NOT_ORDERED)
  paymentId String? // Razorpay payment ID for tracking the ₹199
  paidAt    DateTime?

  // 📝 Document Text Meta (For easy indexing/admin view)
  panNumber       String?
  aadharNumber    String?
  garageRegNumber String?
  gstNumber       String? // Optional

  // 📂 Cloudflare R2 Storage Keys (Secure path strings)
  panDocKey       String? // e.g., "verifications/user_42/pan.pdf"
  aadharDocKey    String?
  garageRegDocKey String?
  gstDocKey       String? // Optional

  // 🛠️ Audit Logs
  adminNotes String? // Reason for rejection if any
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

//car db schemas

model Client {
  id                  Int       @id @default(autoincrement())
  fullName            String
  phone               String
  email               String?
  address             String?
  vehicleMake         String
  vehicleModel        String
  vehicleYear         Int
  regNumber           String
  fuel                String? // ✅ ADD THIS
  seats               Int?
  vin                 String?
  carImage            String?
  adImage             String?
  staffPerson         String?
  receiverName        String?
  damageImages        Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  userId              Int?
  whatsappOptin       Boolean   @default(false)
  whatsappOptinAt     DateTime?
  whatsappOptinSource String?

  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  services            Service[]
  invoices            Invoice[]
  reminders           Reminder[]
  ocrs                OcrRecord[]
  marketplaceBookings MarketplaceBooking[]

  @@unique([userId, regNumber])
  @@index([userId])
  @@index([regNumber])
}

// schema.prisma
model Service {
  id               Int       @id @default(autoincrement())
  date             DateTime
  notes            String?
  partsCost        Float?
  partsGst         Float?
  laborCost        Float?
  laborGst         Float?
  cost             Float?
  status           String?
  priority         String?   @default("Normal")
  serviceInDate    DateTime?
  serviceOutDate   DateTime?
  expectedDelivery DateTime?
  internalNotes    String?
  assignedMechanic String?
  advancePaid      Float?    @default(0)

  approvalStatus String?
  approvalNote   String?
  approvalAt     DateTime?
  approvalSource WhatsAppApprovalSource?

  clientId   Int
  categoryId Int?
  invoiceId  Int?

  subServices SubService[]

  mediaFiles ServiceMedia[]

  client   Client           @relation(fields: [clientId], references: [id])
  invoice  Invoice?         @relation(fields: [invoiceId], references: [id])
  category ServiceCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceCostItems ServiceCostItem[]
  whatsAppSessions WhatsAppSession[]
  whatsAppMessages WhatsAppMessage[]

  reviewSentAt    DateTime?
  reviewRating    Int?
  reviewSource    String?
  reviewMessageId String?

  @@index([clientId])
}

model SubService {
  id         Int    @id @default(autoincrement())
  name       String
  categoryId Int?

  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceMedia {
  id        Int @id @default(autoincrement())
  serviceId Int

  fileName String
  mimeType String
  mediaUrl String // ✅ Cloudflare R2 public URL

  service Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
}

model Invoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  // 🔗 CLIENT
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // 🏢 COMPANY / OWNER (ALWAYS USED FOR INVOICE HEADER)
  ownerUserId Int
  ownerUser   User @relation("OwnerInvoices", fields: [ownerUserId], references: [id], onDelete: Cascade)

  // 👤 CREATED BY (OWNER OR STAFF)
  createdById Int?
  createdBy   User? @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: SetNull)

  // 💰 FINANCIALS
  tax        Float @default(0)
  discount   Float @default(0)
  grandTotal Float

  paymentMode String?
  status      String    @default("Pending")
  paidAt      DateTime?
  dueDate     DateTime?

  // 📝 SERVICE INFO
  notes String?

  serviceCategory    String?
  serviceSubCategory String?
  serviceNotes       String?
  mechanic           String?
  vehicle            String?
  whatsAppMessages   WhatsAppMessage[] // 👈 ADD THIS

  // 🔗 RELATIONS
  services         Service[]
  invoiceCostItems InvoiceCostItem[]
  washingClient    WashingClient?    @relation(fields: [washingClientId], references: [id])
  washingClientId  Int?

  // 🕒 TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?

  // 📌 INDEXES
  @@index([ownerUserId])
  @@index([createdById])
  @@index([status])
  @@index([paymentMode])
}

model InvoiceCostItem {
  id        Int @id @default(autoincrement())
  invoiceId Int

  type String // "part" | "labor"
  name String

  quantity  Int
  unitPrice Float

  cgstRate Float
  sgstRate Float

  totalCost Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ServiceCostItem {
  id        Int @id @default(autoincrement())
  serviceId Int

  type      String // "part" | "labor"
  name      String
  quantity  Int
  unitPrice Float

  cgstRate  Float?
  sgstRate  Float?
  totalCost Float

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Reminder {
  id       Int  @id @default(autoincrement())
  clientId Int
  userId   Int?

  serviceDate DateTime // actual appointment date & time
  note        String?  @db.Text

  remind15At DateTime? // auto-calculated: serviceDate - 15 days
  remind7At  DateTime? // auto-calculated: serviceDate - 7 days

  sent15 Boolean @default(false)
  sent7  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([serviceDate])
  @@index([remind15At])
  @@index([remind7At])
  @@index([clientId])
}

model ServiceCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  subServices SubService[]
  services    Service[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model OcrRecord {
  id         Int      @id @default(autoincrement())
  rawText    String
  parsedData Json
  confidence Float?
  imageUrl   String?
  createdAt  DateTime @default(now())
  clientId   Int
  userId     Int

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model CarStaff {
  id Int @id @default(autoincrement())

  // Owner relationship
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Basic staff info
  name          String
  role          String?
  phone         String?
  joinDate      DateTime @default(now())
  isActive      Boolean  @default(true)
  advanceAmount Float    @default(0)

  // Salary configuration (DEFAULT RULES)
  baseSalary             Float   @default(0)
  deductionPerLeave      Float   @default(0)
  bonusDefault           Float   @default(0)
  extraDeductionsDefault Float   @default(0)
  includeInPayroll       Boolean @default(true)

  // Relations
  login            CarStaffLogin?
  carStaffSalaries CarStaffSalary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model CarStaffLogin {
  id Int @id @default(autoincrement())

  staffId Int
  staff   CarStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  email    String  @unique
  password String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId])
  @@index([ownerId])
}

model CarStaffSalary {
  id Int @id @default(autoincrement())

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  staffId Int
  staff   CarStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // Period
  month Int // 1 - 12
  year  Int

  // Snapshot of salary rules (copied from staff at generation time)
  baseSalary        Float
  deductionPerLeave Float
  bonus             Float
  extraDeductions   Float

  // Monthly data
  leaves         Int
  leaveDeduction Float

  // Final computed value (LOCKED)
  netSalary Float

  // Payment status
  status SalaryStatus @default(UNPAID)
  paidAt DateTime?
  paidBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, month, year])
  @@index([ownerId])
}

model Payment {
  id String @id @default(cuid())

  // Link to user
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  // Customer Details
  customerName String?
  companyName  String?
  email        String?
  phone        String?

  // Plan should be enum
  plan          PlanType?
  billingPeriod String?
  amount        Float?

  originalAmount           Float?
  discountAmount           Float?
  discountPercent          Float?
  firstPaymentDiscountUsed Boolean @default(false)

  referralCode String?
  gstNumber    String?
  address      String?

  paymentId String? @unique
  orderId   String? @unique
  signature String?

  subscriptionId  String?   @unique
  isTrial         Boolean   @default(false)
  trialEndDate    DateTime?
  nextBillingDate DateTime?
  status          String    @default("PENDING")

  paidAt     DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model DynamicTable {
  id        String   @id @default(uuid())
  name      String
  userId    Int
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns DynamicColumn[]
  rows    DynamicRow[]

  @@unique([userId, name])
  @@index([userId])
}

model DynamicColumn {
  id        String            @id @default(uuid())
  tableId   String
  name      String
  type      DynamicColumnType
  required  Boolean           @default(false)
  createdAt DateTime          @default(now())

  table DynamicTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, name])
  @@index([tableId])
}

model DynamicRow {
  id        String   @id @default(uuid())
  tableId   String
  data      Json // 🔥 flexible user data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table DynamicTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

// Bike Tables

model Bike {
  id Int @id @default(autoincrement())

  ownerName String
  phone     String
  email     String?
  address   String?

  bikeBrand String
  bikeModel String
  bikeYear  Int?

  regNumber    String
  engineNumber String?
  vin          String?

  bikeImage    String?
  adImage      String?
  damageImages Json? // ⚠️ Change to Json (like car)

  receiverName String?
  color        String?
  fuel         String?
  notes        String?

  ownerUserId Int
  createdById Int

  ownerUser User @relation("OwnerBikes", fields: [ownerUserId], references: [id])
  createdBy User @relation("CreatedBikes", fields: [createdById], references: [id])

  bikeServices   BikeService[]
  bikeInvoices   BikeInvoice[]
  bikeReminders  BikeReminder[]
  bikeOcrRecords BikeOcrRecord[]

  whatsappOptin       Boolean   @default(false)
  whatsappOptinAt     DateTime?
  whatsappOptinSource String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt // ✅ ADD THIS

  @@unique([ownerUserId, regNumber]) // ✅ IMPORTANT
  @@index([ownerUserId])
  @@index([createdById])
  @@index([regNumber])
}

model BikeService {
  id Int @id @default(autoincrement())

  clientId Int
  client   Bike @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // 🔽 MAKE OPTIONAL
  categoryId Int?
  category   BikeServiceCategory? @relation(fields: [categoryId], references: [id])

  subServiceId Int?
  subService   BikeSubService? @relation(fields: [subServiceId], references: [id])

  categoryText   String?
  subServiceText String?

  inDate           DateTime
  outDate          DateTime?
  expectedDelivery DateTime?

  status           String  @default("Pending")
  priority         String  @default("Normal")
  assignedMechanic String?
  notes            String?

  partsSubtotal Float @default(0)
  laborSubtotal Float @default(0)
  cgstTotal     Float @default(0)
  sgstTotal     Float @default(0)

  discountType String @default("Fixed Amount")
  discount     Float  @default(0)
  advancePaid  Float  @default(0)

  grandTotal Float @default(0)
  balanceDue Float @default(0)

  invoiceStatus String @default("draft")

  bikeInvoiceId Int?
  bikeInvoice   BikeInvoice? @relation("InvoiceServices", fields: [bikeInvoiceId], references: [id])

  ownerUserId Int
  createdById Int

  ownerUser User @relation("OwnerBikeServices", fields: [ownerUserId], references: [id])
  createdBy User @relation("CreatedBikeServices", fields: [createdById], references: [id])

  serviceItems ServiceItem[]
  serviceMedia BikeServiceMedia[]

  bikeWhatsAppSessions BikeWhatsAppSession[]
  bikeWhatsAppMessages BikeWhatsAppMessage[]

  // ===== REVIEW SYSTEM =====
  reviewSentAt    DateTime?
  reviewRating    Int?
  reviewSource    String?
  reviewMessageId String?
  // ✅ APPROVAL WORKFLOW (FIXED)
  approvalStatus  String? // ❌ NO DEFAULT
  approvalNote    String?
  approvalAt      DateTime?
  approvalSource  WhatsAppApprovalSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

model BikeInvoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  bikeId Int
  bike   Bike @relation(fields: [bikeId], references: [id], onDelete: Cascade)

  vehicle            String?
  serviceCategory    String?
  serviceSubCategory String?
  notes              String?

  partsSubtotal Float @default(0)
  laborSubtotal Float @default(0)
  cgstTotal     Float @default(0)
  sgstTotal     Float @default(0)

  discountType String @default("Fixed Amount")
  discount     Float  @default(0)
  advancePaid  Float  @default(0)

  grandTotal Float @default(0)
  balanceDue Float @default(0)

  paymentMode String?
  status      String    @default("Pending")
  paidAt      DateTime?

  ownerUserId Int
  ownerUser   User @relation("OwnerBikeInvoices", fields: [ownerUserId], references: [id])

  bikeServices BikeService[] @relation("InvoiceServices")

  createdById Int
  createdBy   User @relation("CreatedBikeInvoices", fields: [createdById], references: [id])

  invoiceItems InvoiceItem[]

  bikeWhatsAppMessages BikeWhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ✅ NEW: Invoice Items Model
model InvoiceItem {
  id Int @id @default(autoincrement())

  bikeInvoiceId Int
  bikeInvoice   BikeInvoice @relation(fields: [bikeInvoiceId], references: [id], onDelete: Cascade)

  type      String // Part | Labor
  name      String
  quantity  Int
  unitPrice Float
  cgst      Float  @default(0)
  sgst      Float  @default(0)
  total     Float

  createdAt DateTime @default(now())
}

model BikeReminder {
  id Int @id @default(autoincrement())

  bikeId Int
  userId Int?

  serviceDate DateTime
  note        String?  @db.Text

  remind15At DateTime?
  remind7At  DateTime?

  sent15 Boolean @default(false)
  sent7  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bike Bike  @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([serviceDate])
  @@index([remind15At])
  @@index([remind7At])
  @@index([bikeId])
}

model BikeOcrRecord {
  id Int @id @default(autoincrement())

  bikeClientId Int
  bike         Bike @relation(fields: [bikeClientId], references: [id], onDelete: Cascade)

  ownerUserId Int
  createdById Int?

  ownerUser User  @relation("OwnerBikeOcrRecords", fields: [ownerUserId], references: [id])
  createdBy User? @relation("CreatedBikeOcrRecords", fields: [createdById], references: [id])

  rawText    String
  parsedData Json
  confidence Float?
  imageUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceItem {
  id Int @id @default(autoincrement())

  bikeServiceId Int
  bikeService   BikeService @relation(fields: [bikeServiceId], references: [id], onDelete: Cascade)

  type      String // Part | Labor
  name      String
  quantity  Int
  unitPrice Float
  cgst      Float  @default(0)
  sgst      Float  @default(0)
  total     Float

  createdAt DateTime @default(now())
}

model BikeServiceCategory {
  id   Int    @id @default(autoincrement())
  name String

  bikeBrand String? // Honda, Yamaha, etc

  subServices BikeSubService[]
  services    BikeService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeSubService {
  id   Int    @id @default(autoincrement())
  name String

  categoryId Int
  category   BikeServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  services BikeService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeServiceMedia {
  id Int @id @default(autoincrement())

  bikeServiceId Int
  service       BikeService @relation(fields: [bikeServiceId], references: [id], onDelete: Cascade)

  fileName String?
  mimeType String?
  data     Bytes
  r2Url    String?

  createdAt DateTime @default(now())
}

model Staff {
  id Int @id @default(autoincrement())

  name    String
  email   String?
  phone   String?
  address String?
  role    String

  annualSalary Float

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  salaries BikeStaff[] @relation("StaffSalaries")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
}

model BikeStaff {
  id Int @id @default(autoincrement())

  // 🔗 Staff reference (NEW)
  staffId Int
