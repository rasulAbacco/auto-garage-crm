// MARKETPLACE LAYER (NEW)
// ==============================

model MarketplaceService {
  id   Int     @id @default(autoincrement())
  name String
  slug String? @unique // ← make optional (resolveService doesn't send it)

  crmType CrmType? // ← make optional

  mainCategory      String?
  subCategory       String?
  externalServiceId String? @unique
  basePrice         Float?
  description       String?
  image             String?
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garageServices          GarageMarketplaceService[]
  bookings                MarketplaceBooking[]
  marketplacePackageItems MarketplacePackageItem[]

  @@index([crmType])
  @@index([externalServiceId])
}

model GarageMarketplaceService {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId Int
  service   MarketplaceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // override base price
  price    Float?
  duration Int?

  isActive Boolean @default(true)
  discount Float?  @default(0)

  pricing GarageServicePricing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, serviceId])
}

model GarageServicePricing {
  id Int @id @default(autoincrement())

  garageServiceId Int
  garageService   GarageMarketplaceService @relation(fields: [garageServiceId], references: [id], onDelete: Cascade)

  carType  String // SEDAN, SUV, etc.
  price    Float
  discount Float? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageServiceId, carType])
}

model MarketplaceBooking {
  id Int @id @default(autoincrement())

  serviceId Int
  service   MarketplaceService @relation(fields: [serviceId], references: [id])

  garageId Int?
  garage   User? @relation(fields: [garageId], references: [id])

  appUserId String?
  vehicleId String?
  carType   String?

  scheduledAt DateTime

  // Make these optional — snapshot filled from app data
  serviceName  String? // ← was String (non-null), now optional
  mainCategory String? // ← was String, now optional
  subCategory  String? // ← was String, now optional

  basePriceSnapshot   Float  @default(0) // ← was Float (required), now has default
  garagePriceSnapshot Float?
  discountSnapshot    Float?
  finalPrice          Float  @default(0) // ← add default

  status MarketplaceBookingStatus @default(PENDING)

  carServiceId     Int?
  bikeServiceId    Int?
  washingServiceId Int?

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  // ==============================
  // 🆕 CUSTOMER NOTES / SPECIAL INSTRUCTIONS
  // ==============================
  notes String?

  // ==============================
  // 🆕 PICKUP / DROP DETAILS
  // ==============================
  pickupRequired Boolean? @default(false)
  pickupAddress  String?
  dropAddress    String?

  // ==============================
  // 🆕 VEHICLE DETAILS (snapshot from app at time of booking)
  // Separate from `carType` (SEDAN/HATCHBACK/etc) which already existed
  // ==============================
  vehicleMake      String?
  vehicleModel     String?
  vehicleRegNumber String?
  vehicleYear      Int?
  vehicleFuelType  String?

  // ==============================
  // 🆕 PACKAGE / MULTI-SERVICE SUPPORT
  // Kept as plain scalars (no FK relation) to avoid touching MarketplacePackage model
  // ==============================
  packageId   Int?
  packageName String?

  // Full structured breakdown of every service included in this booking
  // (e.g. [{ "serviceName": "Oil Change", "fromPackage": "Basic Combo" }, ...])
  services Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications AppNotification[]

  @@index([garageId])
  @@index([serviceId])
}

model MarketplacePackage {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  name        String
  description String?

  price    Float
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         MarketplacePackageItem[]
  notifications AppNotification[]

  @@index([userId])
}

model MarketplacePackageItem {
  id Int @id @default(autoincrement())

  packageId Int
  serviceId Int

  // 🔗 RELATIONS
  package MarketplacePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service MarketplaceService @relation(fields: [serviceId], references: [id])

  // 🔥 CRITICAL: External reference (bridge)
  externalServiceId String

  // 🔥 SNAPSHOT (for stability)
  serviceName String
  basePrice   Float?

  createdAt DateTime @default(now())

  @@unique([packageId, serviceId])
  // ⚡ Important indexes
  @@index([packageId])
  @@index([serviceId])
  @@index([externalServiceId])
}

// ==============================
// ENUM
// ==============================

enum MarketplaceBookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  TIMEOUT
  CANCELLED
}

// Notification scope: GLOBAL = all app users, USER = specific client by phone
enum NotificationScope {
  GLOBAL
  USER
}

enum NotificationType {
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  NEW_PACKAGE
  GENERAL
}

model AppNotification {
  id Int @id @default(autoincrement())

  // Who created this (CRM garage owner or system)
  createdByUserId Int?
  createdBy       User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Notification content
  type    NotificationType
  title   String
  body    String
  iconKey String? // e.g. "car", "package", "shield" — frontend maps to icon

  // Scope: GLOBAL = everyone, USER = specific client phone
  scope       NotificationScope @default(GLOBAL)
  clientPhone String? // only set when scope = USER

  // Booking link (optional — for booking notifications)
  bookingId Int?
  booking   MarketplaceBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // Package link (optional — for package notifications)
  packageId Int?
  package   MarketplacePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // Soft metadata
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([clientPhone])
  @@index([type])
  @@index([createdAt])
}

